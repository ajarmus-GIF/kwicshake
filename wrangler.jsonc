// Cloudflare Workers deploy config. `npm run build` writes the static site to /out and
// `npx wrangler deploy` uploads it as static assets — no Worker script, nothing runs per request.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kwicshake",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./out",
    // Serve /work/revolt-lacrosse from work/revolt-lacrosse.html, and Next's 404 page for
    // anything that doesn't exist.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Lets `npx wrangler preview` (the Workers Builds preview command) make a preview URL for
  // each non-production branch. Empty on purpose: assets and settings above apply to previews too.
  "previews": {},
  // The live addresses. Both are Custom Domains on this Worker: each deploy keeps exactly these
  // two attached, and Cloudflare creates (or takes over) their DNS records and certificates.
  "routes": [
    { "pattern": "kwicshake.com", "custom_domain": true },
    { "pattern": "www.kwicshake.com", "custom_domain": true }
  ],
  // Keep the *.workers.dev address and branch preview URLs on. Wrangler turns workers.dev off
  // by default as soon as any routes are listed.
  "workers_dev": true
}
